function setup() {
  createCanvas(400, 400);
}

function draw() {
  background(201, 175, 255);
  
  fill (140, 175, 255,120)
  stroke (0,0,0)
  rect(100,100,200,200)

  fill (140, 275, 155,120)
   rect(120,120,155,70)
  
  
  fill(255,255,255,)
  strokeWeight (0)
  ellipse (150, 160, 40, 40)
  noFill()
  ellipse (250, 160, 40, 40)
  fill(0)
  ellipse (150, 160, 15, 15)
  ellipse (250, 160, 15, 15)

  strokeWeight (5)
  noStroke()
  line(150 ,240, 250, 240)

  fill(230, 126, 34)
  strokeWeight (2)
  triangle(200, 180, 185, 210, 215, 210)
  
}
