// =================================================================
// ALTAR DIGITAL ISC & COCO - VELOCIDAD DE VELAS SUAVIZADA
// Proyecto AA 2.2: Escenario Dinámico
// =================================================================

let modoEscena = true;      // true: Fiesta Tradicional / false: Red Matrix
let velasEncendidas = true; // Interruptor de llamas
let particulasMouse = [];   // Destellos al hacer clic
let petalosCaida = [];      // Lluvia de pétalos de cempasúchil
let petalosSuelo = [];      // Mosaico del camino de cempasúchil

// Variables de estado de animación para la Calavera ISC
let estadoCalavera = "idle"; // "idle", "saludar", "comer"
let timerAccionCalavera = 0;

function setup() {
  p5.instance._friendlyErrorSystem = false; // Desactiva falsas alarmas de bucles
  createCanvas(windowWidth, windowHeight);
  angleMode(DEGREES);
  rectMode(CENTER);
  ellipseMode(CENTER);

  // Inicializar lluvia de pétalos (cantidad moderada)
  petalosCaida = [];
  for (let i = 0; i < 35; i++) {
    petalosCaida.push({
      x: random(width),
      y: random(-height, height),
      tam: random(6, 12),
      vaciaY: random(1.0, 2.2),
      oscilacionX: random(0.3, 1.2),
      fase: random(360),
      rotacion: random(360),
      vRot: random(-2.5, 2.5)
    });
  }

  generarPetalosSuelo();
}

function generarPetalosSuelo() {
  petalosSuelo = [];
  for (let i = 0; i < 40; i++) {
    petalosSuelo.push({
      t: random(1),
      offsetRel: random(-0.5, 0.5),
      alfa: random(180, 255),
      g: random(110, 210)
    });
  }
}

function draw() {
  // 1. FONDO
  if (modoEscena) {
    background(16, 9, 28);
    dibujarResplandorFondo();
  } else {
    background(6, 12, 20);
    dibujarEfectoMatrix();
  }

  // Papel Picado
  dibujarPapelPicadoSuperior();

  // 2. CAMINO Y VELADORAS LATERALES
  let xCentro = width / 2;
  let yBaseAltar = height * 0.74;

  dibujarCaminoCempasuchilPerspectiva(xCentro, yBaseAltar);
  dibujarVeladorasCaminoCempasuchil(xCentro, yBaseAltar);

  // 3. ESTRUCTURA ELEVADA DEL ALTAR Y SUS ELEMENTOS
  push();

  dibujarPatasDeMesa(xCentro, yBaseAltar);
  dibujarArcoCempasuchilMagnifico(xCentro, yBaseAltar - 110);
  dibujarEscalonesAltar(xCentro, yBaseAltar);

  // Veladoras organizadas en el Altar
  dibujarVeladorasEnAltar(xCentro, yBaseAltar);

  // Marcos de Retratos
  dibujarRetratosTradicionales(xCentro, yBaseAltar);

  // OFRENDAS TRADICIONALES
  dibujarOfrendasAltar(xCentro, yBaseAltar);

  // CALAVERITA ANIMADA INTERACTIVA CON GORRA Y PLAYERA ISC
  dibujarCalaveraISCAnimada(xCentro, yBaseAltar - 58);

  // Guitarra Blanca de Miguel/Héctor
  dibujarGuitarraCocoRecargada(xCentro + width * 0.27, yBaseAltar + 18);

  // Calaveritas estáticas en las esquinas inferiores
  dibujarCalaveraGlitch(xCentro - width * 0.32, yBaseAltar - 5);
  dibujarCalaveraGlitch(xCentro + width * 0.32, yBaseAltar - 5);

  pop();

  // 4. SISTEMA DE PARTÍCULAS
  actualizarYRenderizarPetalos();
  actualizarYRenderizarDestellos();

  // Actualizar tiempo de animación de la calaverita
  if (timerAccionCalavera > 0) {
    timerAccionCalavera--;
    if (timerAccionCalavera === 0) {
      estadoCalavera = "idle";
    }
  }

  // 5. LEYENDA E INSTRUCCIONES
  dibujarBarraControles();
}

// -----------------------------------------------------------------
// PERSONAJE: CALAVERITA DE ISC ANIMADA E INTERACTIVA
// -----------------------------------------------------------------

function dibujarCalaveraISCAnimada(cx, cy) {
  push();
  translate(cx, cy);

  let escala = map(width, 400, 1400, 0.65, 1.05, true);
  scale(escala);

  let oscY = sin(frameCount * 4) * 2;
  translate(0, oscY);

  fill(15, 25, 45);
  stroke(0, 255, 200);
  strokeWeight(1.8);
  rect(0, 16, 32, 22, 4);

  noStroke();
  fill(0, 255, 200);
  textAlign(CENTER, CENTER);
  textSize(7);
  textStyle(BOLD);
  text("ISC", 0, 16);

  fill(250);
  stroke(40);
  strokeWeight(2);
  ellipse(0, -6, 38, 32);

  rect(0, 8, 16, 8, 2);
  stroke(80);
  strokeWeight(1);
  line(-4, 5, -4, 10);
  line(0, 5, 0, 10);
  line(4, 5, 4, 10);

  let parpadeo = sin(frameCount * 6) > 0.95 ? 1 : 8;
  fill(0, 255, 200);
  noStroke();
  ellipse(-8, -8, 8, parpadeo);
  ellipse(8, -8, 8, parpadeo);

  fill(30);
  triangle(-2, -3, 2, -3, 0, 0);

  push();
  translate(0, -18);
  fill(0, 180, 120);
  stroke(0, 255, 180);
  strokeWeight(1.5);
  arc(0, 2, 38, 22, 180, 360, CHORD);

  fill(0, 220, 140);
  ellipse(6, 4, 32, 8);

  fill(255);
  noStroke();
  textSize(6.5);
  textStyle(BOLD);
  text("ISC", -4, -3);
  pop();

  if (estadoCalavera === "saludar") {
    push();
    translate(18, 10);
    let anguloMano = sin(frameCount * 25) * 20;
    rotate(-110 + anguloMano);
    stroke(250);
    strokeWeight(4);
    line(0, 0, 16, 0);
    fill(250);
    noStroke();
    ellipse(18, 0, 6, 6);
    pop();
  } else if (estadoCalavera === "comer") {
    push();
    translate(14, 12);
    rotate(-50);
    stroke(250);
    strokeWeight(4);
    line(0, 0, 14, -8);

    fill(210, 140, 50);
    noStroke();
    ellipse(16, -10, 10, 8);
    fill(255, 230, 180);
    ellipse(16, -12, 3, 3);
    pop();

    if (frameCount % 6 === 0) {
      particulasMouse.push({
        x: cx + random(-6, 6),
        y: cy + 4,
        vx: random(-1.5, 1.5),
        vy: random(1, 3),
        tam: random(2, 4),
        vida: 120,
        r: 230, g: 160, b: 60
      });
    }
  } else {
    stroke(250);
    strokeWeight(3.5);
    line(-16, 12, -20, 22);
    line(16, 12, 20, 22);
  }

  pop();
}

// -----------------------------------------------------------------
// OFRENDAS TRADICIONALES
// -----------------------------------------------------------------

function dibujarOfrendasAltar(xCentro, yBase) {
  let offsetNivel2 = width * 0.17;
  let offsetNivel3 = width * 0.21;

  dibujarPlatoTamales(xCentro - offsetNivel2, yBase - 48);
  dibujarTazonDulces(xCentro + offsetNivel2, yBase - 48);
  dibujarCerveza(xCentro - offsetNivel3, yBase - 2);
  dibujarPlatoMole(xCentro + offsetNivel3, yBase - 2);
}

function dibujarPlatoTamales(x, y) {
  push();
  translate(x, y);
  let escala = map(width, 400, 1400, 0.55, 1.0, true);
  scale(escala);

  fill(160, 80, 40);
  stroke(100, 45, 20);
  strokeWeight(1.2);
  ellipse(0, 0, 30, 12);

  fill(180, 170, 90);
  stroke(130, 120, 50);
  rect(-5, -4, 13, 7, 3);
  rect(4, -5, 13, 7, 3);
  pop();
}

function dibujarTazonDulces(x, y) {
  push();
  translate(x, y);
  let escala = map(width, 400, 1400, 0.55, 1.0, true);
  scale(escala);

  fill(170, 75, 35);
  stroke(110, 40, 15);
  strokeWeight(1.2);
  arc(0, 2, 26, 16, 0, 180, CHORD);

  noStroke();
  fill(255, 100, 180);
  ellipse(-5, -2, 6, 6);
  fill(255, 230, 0);
  ellipse(0, -4, 7, 7);
  fill(0, 200, 180);
  ellipse(5, -2, 6, 6);
  pop();
}

function dibujarCerveza(x, y) {
  push();
  translate(x, y);
  let escala = map(width, 400, 1400, 0.55, 1.0, true);
  scale(escala);

  fill(30, 80, 40);
  stroke(15, 50, 25);
  strokeWeight(1);
  rect(-8, -4, 8, 15, 2);
  rect(-8, -13, 4, 9, 1);

  fill(230, 230, 240, 180);
