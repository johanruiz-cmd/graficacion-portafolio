}

// -----------------------------------------------------------------
// ARCO DE CEMPASÚCHIL Y CRUZ
// -----------------------------------------------------------------

function dibujarArcoCempasuchilMagnifico(cx, cy) {
  push();
  translate(cx, cy);

  let radioX = width * 0.38;
  let radioY = height * 0.44;

  noFill();
  stroke(255, 120, 0, 45);
  strokeWeight(38);
  arc(0, 0, radioX, radioY, 180, 360);

  stroke(255, 180, 0, 80);
  strokeWeight(26);
  arc(0, 0, radioX, radioY, 180, 360);

  stroke(210, 140, 20);
  strokeWeight(12);
  arc(0, 0, radioX, radioY, 180, 360);

  noStroke();
  let numFlores = 24;
  for (let i = 0; i <= numFlores; i++) {
    let angulo = map(i, 0, numFlores, 180, 360);
    let fx = (radioX / 2) * cos(angulo);
    let fy = (radioY / 2) * sin(angulo);

    push();
    translate(fx, fy);
    fill(255, 140, 0);
    ellipse(0, 0, 22, 22);
    fill(255, 200, 0);
    ellipse(0, 0, 15, 15);
    fill(255, 240, 100);
    ellipse(0, 0, 8, 8);
    pop();
  }

  push();
  translate(0, -radioY / 2 - 12);
  fill(255, 220, 100, 100);
  ellipse(0, 0, 36, 36);

  fill(255, 190, 30);
  stroke(255, 240, 150);
  strokeWeight(2);

  rect(0, 0, 12, 32, 3);
  rect(0, -4, 26, 11, 3);

  fill(0, 255, 200);
  noStroke();
  rect(0, -4, 6, 6, 1);
  pop();

  pop();
}

// -----------------------------------------------------------------
// CAMINO Y VELADORAS EN PERSPECTIVA
// -----------------------------------------------------------------

function dibujarCaminoCempasuchilPerspectiva(xCentro, yBase) {
  push();
  let yInicio = yBase + 10;
  let yFin = height;

  noStroke();
  fill(240, 120, 0, 190);
  beginShape();
  vertex(xCentro - width * 0.28, yInicio);
  vertex(xCentro + width * 0.28, yInicio);
  vertex(width * 0.95, yFin);
  vertex(width * 0.05, yFin);
  endShape(CLOSE);

  fill(255, 175, 0, 110);
  beginShape();
  vertex(xCentro - width * 0.18, yInicio);
  vertex(xCentro + width * 0.18, yInicio);
  vertex(width * 0.80, yFin);
  vertex(width * 0.20, yFin);
  endShape(CLOSE);

  let limite = min(petalosSuelo.length, 50);
  for (let i = 0; i < limite; i++) {
    let p = petalosSuelo[i];
    let y = lerp(yInicio, yFin, p.t);
    let anchoActual = lerp(width * 0.56, width * 0.9, p.t);
    let x = xCentro + p.offsetRel * anchoActual;
    let tam = lerp(3, 12, p.t);

    fill(255, p.g, 0, p.alfa);
    ellipse(x, y, tam * 1.6, tam);
  }
  pop();
}

function dibujarVeladorasCaminoCempasuchil(xCentro, yBase) {
  let numVelas = 8;
  let yInicio = yBase + 12;
  let yFin = height - 12;

  for (let i = 0; i < numVelas; i++) {
    let t = i / (numVelas - 1);
    let yVela = lerp(yInicio, yFin, t);

    let offsetAncho = lerp(width * 0.29, width * 0.47, t);
    let xIzq = xCentro - offsetAncho;
    let xDer = xCentro + offsetAncho;

    let escala = lerp(0.5, 1.25, t);

    dibujarVeladoraIndividual(xIzq, yVela, escala);
    dibujarVeladoraIndividual(xDer, yVela, escala);
  }
}

function dibujarVeladoraIndividual(x, y, escala) {
  push();
  translate(x, y);
  scale(escala);

  noStroke();
  fill(10, 5, 18, 120);
  ellipse(0, 14, 24, 8);

  fill(245, 245, 250, 230);
  stroke(170, 170, 190);
  strokeWeight(1.2);
  rect(0, 0, 16, 28, 3);

  fill(0, 255, 200, 210);
  noStroke();
  rect(0, 4, 11, 3);

  if (velasEncendidas) {
    push();
    translate(0, -17);
    // VELOCIDAD SUAVIZADA: Se redujo el multiplicador de frameCount (de 14 y 18 a 4 y 5)
    let oscX = map(sin(frameCount * 4 + x * 7), -1, 1, 0.88, 1.12);
    let oscY = map(cos(frameCount * 5 + y * 7), -1, 1, 0.90, 1.15);
    scale(oscX, oscY);

    fill(255, 130, 0, 75);
    ellipse(0, 0, 24, 34);

    fill(255, 110, 0, 230);
    ellipse(0, 0, 12, 22);

    fill(255, 235, 80);
    ellipse(0, 2, 6, 11);
    pop();
  }
  pop();
}

// -----------------------------------------------------------------
// ESCALONES DEL ALTAR Y COMPONENTES
// -----------------------------------------------------------------

function dibujarPatasDeMesa(x, y) {
  push();
  translate(x, y);
  fill(14, 20, 32);
  stroke(0, 255, 200, 160);
  strokeWeight(2);

  let anchoMesa = width * 0.64;
  rect(-anchoMesa * 0.44, 28, 18, 56, 4);
  rect(anchoMesa * 0.44, 28, 18, 56, 4);
  pop();
}

function dibujarEscalonesAltar(x, y) {
  push();
  translate(x, y);

  fill(75, 18, 115);
  stroke(135, 45, 185);
  strokeWeight(2);
  rect(0, 0, width * 0.66, 46, 6);
  dibujarCenefaPapel(0, 18, width * 0.66, color(0, 230, 255));

  fill(95, 24, 140);
  rect(0, -46, width * 0.48, 46, 6);
  dibujarCenefaPapel(0, -28, width * 0.48, color(255, 0, 140));

  fill(115, 30, 165);
  rect(0, -92, width * 0.30, 46, 6);
  dibujarCenefaPapel(0, -74, width * 0.30, color(255, 200, 0));

  pop();
}

function dibujarCenefaPapel(cx, cy, ancho, col) {
  push();
  translate(cx, cy);
  fill(col);
  noStroke();

  let num = max(1, floor(ancho / 20));
  let paso = ancho / num;

  for (let i = 0; i < num; i++) {
    let xOffset = -ancho / 2 + paso * i + paso / 2;
    rect(xOffset, 0, paso - 4, 8, 2);
    ellipse(xOffset, 4, 4, 4);
  }
  pop();
}

function dibujarVeladorasEnAltar(x, y) {
  dibujarVeladoraIndividual(x - width * 0.10, y - 114, 0.72);
  dibujarVeladoraIndividual(x + width * 0.10, y - 114, 0.72);

  dibujarVeladoraIndividual(x - width * 0.19, y - 68, 0.82);
  dibujarVeladoraIndividual(x + width * 0.19, y - 68, 0.82);

  dibujarVeladoraIndividual(x - width * 0.26, y - 22, 0.92);
  dibujarVeladoraIndividual(x - width * 0.13, y - 22, 0.92);
  dibujarVeladoraIndividual(x + width * 0.13, y - 22, 0.92);
}

function dibujarRetratosTradicionales(x, y) {
  dibujarMarcoRetrato(x, y - 116, 28, 36);
  dibujarMarcoRetrato(x - width * 0.11, y - 70, 30, 38);
  dibujarMarcoRetrato(x + width * 0.11, y - 70, 30, 38);
}

function dibujarMarcoRetrato(rx, ry, w, h) {
  push();
  translate(rx, ry);

  fill(220, 175, 50);
  stroke(255, 230, 120);
  strokeWeight(2);
  rect(0, 0, w, h, 4);

  fill(35, 25, 20);
  noStroke();
  rect(0, 0, w - 6, h - 6, 2);

  fill(215, 175, 135);
  ellipse(0, -3, w * 0.36, w * 0.36);
  fill(150, 110, 80);
  arc(0, h * 0.3, w * 0.62, h * 0.52, 180, 360);
  pop();
}

function dibujarGuitarraCocoRecargada(gx, gy) {
  push();
  translate(gx, gy);

  let escala = map(width, 400, 1400, 0.6, 1.0, true);
  scale(escala);
  rotate(-16);

  fill(250, 250, 255);
  stroke(170, 170, 190);
  strokeWeight(1.5);
  ellipse(0, 16, 36, 44);
  ellipse(0, -10, 28, 32);

  fill(25);
  stroke(210, 170, 50);
  strokeWeight(1.6);
  ellipse(0, -2, 12, 12);

  fill(95, 55, 25);
  stroke(50, 25, 10);
  strokeWeight(1);
  rect(0, -48, 8, 52);

  fill(252);
  stroke(170);
  rect(0, -78, 14, 18, 3);
  fill(10);
  ellipse(-3, -80, 3, 3);
  ellipse(3, -80, 3, 3);

  stroke(210, 210, 240, 210);
  strokeWeight(0.8);
  for (let c = -2; c <= 2; c += 1) {
    line(c, 26, c, -74);
  }
  pop();
}

function dibujarCalaveraGlitch(kx, ky) {
  push();
  translate(kx, ky);

  let escala = map(width, 400, 1400, 0.6, 1.0, true);
  scale(escala);

  fill(248);
  stroke(35);
  strokeWeight(1.5);
  ellipse(0, 0, 26, 24);
  rect(0, 9, 11, 7, 2);

  fill(255, 0, 120);
  ellipse(-5, -2, 7, 7);
  ellipse(5, -2, 7, 7);
  fill(15);
  ellipse(-5, -2, 3, 3);
  ellipse(5, -2, 3, 3);
  pop();
}

// -----------------------------------------------------------------
// PAPEL PICADO Y EFECTOS
// -----------------------------------------------------------------

function dibujarPapelPicadoSuperior() {
  let colores = [
    color(0, 190, 230),
    color(245, 0, 125),
    color(155, 35, 210),
    color(255, 185, 0),
    color(0, 210, 120)
  ];
  let num = 10;
  let ancho = width / num;

  stroke(255, 90);
  strokeWeight(1);
  noFill();
  beginShape();
  let pasos = 20;
  for (let i = 0; i <= pasos; i++) {
    let x = (width / pasos) * i;
    let y = 16 + sin(x * 0.6 + frameCount * 1.5) * 5;
    vertex(x, y);
  }
  endShape();

  for (let i = 0; i < num; i++) {
    push();
    let x = i * ancho + ancho / 2;
    let yCuerda = 16 + sin(x * 0.6 + frameCount * 1.5) * 5;
    translate(x, yCuerda + 18);
    rotate(sin(frameCount * 2 + i * 25) * 3.5);

    fill(colores[i % colores.length]);
    noStroke();
    rect(0, 0, max(1, ancho - 10), 36, 3);

    fill(16, 9, 28);
    ellipse(0, -4, 8, 8);
    rect(-6, 6, 4, 4);
    rect(6, 6, 4, 4);
    pop();
  }
}

function dibujarResplandorFondo() {
  noStroke();
  fill(255, 130, 0, 16);
  ellipse(width / 2, height / 2, width * 0.75, height * 0.75);
}

function dibujarEfectoMatrix() {
  fill(0, 255, 120, 45);
  textSize(11);
  textFont('monospace');
  
  let columnas = 10;
  let filas = 8;
  let pasoX = width / columnas;
  let pasoY = height / filas;

  for (let i = 0; i < columnas; i++) {
    for (let j = 0; j < filas; j++) {
      let x = i * pasoX + 20;
      let y = j * pasoY + 30;
      let charBit = (i + j + frameCount) % 2 === 0 ? "1" : "0";
      text(charBit, x, y);
    }
  }
}

// -----------------------------------------------------------------
// ANIMACIONES Y SISTEMA DE PARTÍCULAS
// -----------------------------------------------------------------

function actualizarYRenderizarPetalos() {
  for (let i = 0; i < petalosCaida.length; i++) {
    let p = petalosCaida[i];
    p.y += p.vaciaY;
    p.x += sin(frameCount * p.oscilacionX + p.fase) * 0.8;
    p.rotacion += p.vRot;

    if (p.y > height + 20) {
      p.y = -20;
      p.x = random(width);
    }

    push();
    translate(p.x, p.y);
    rotate(p.rotacion);
    fill(255, 160, 0, 220);
    noStroke();
    ellipse(0, 0, p.tam, p.tam * 0.5);
    pop();
  }
}

function actualizarYRenderizarDestellos() {
  if (particulasMouse.length > 30) {
    particulasMouse.splice(0, particulasMouse.length - 30);
  }

  for (let i = particulasMouse.length - 1; i >= 0; i--) {
    let pm = particulasMouse[i];
    pm.x += pm.vx;
    pm.y += pm.vy;
    pm.vida -= 4.0;

    noStroke();
    fill(pm.r, pm.g, pm.b, pm.vida);
    ellipse(pm.x, pm.y, pm.tam);

    if (pm.vida <= 0) {
      particulasMouse.splice(i, 1);
    }
  }
}

function dibujarBarraControles() {
  push();
  fill(255, 220);
  noStroke();
  textSize(12);
  textAlign(LEFT, BOTTOM);
  text(" [ESPACIO] Fondo  |  [V] Velas  |  [S] Saludo Calavera  |  [C] Comer Ofrenda", 20, height - 16);
  pop();
}

// -----------------------------------------------------------------
// EVENTOS TECLADO Y MOUSE
// -----------------------------------------------------------------

function mousePressed() {
  for (let i = 0; i < 8; i++) {
    particulasMouse.push({
      x: mouseX,
      y: mouseY,
      vx: random(-3, 3),
      vy: random(-3, 3),
      tam: random(4, 8),
      vida: 255,
      r: random(100, 255),
      g: 255,
      b: random(150, 255)
    });
  }
}

function keyPressed() {
  if (key === ' ' || keyCode === 32) {
    modoEscena = !modoEscena;
  }
  if (key === 'v' || key === 'V') {
    velasEncendidas = !velasEncendidas;
  }
  if (key === 's' || key === 'S') {
    estadoCalavera = "saludar";
    timerAccionCalavera = 60;
  }
  if (key === 'c' || key === 'C') {
    estadoCalavera = "comer";
    timerAccionCalavera = 80;
  }
}

function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
  generarPetalosSuelo();
}
