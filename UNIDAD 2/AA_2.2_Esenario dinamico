  fill(180, 85, 45);
  stroke(120, 50, 25);
  strokeWeight(1.2);
  ellipse(0, 0, 28, 11);

  fill(70, 35, 15);
  noStroke();
  ellipse(0, -1, 20, 7);
  fill(255, 230, 180);
  ellipse(-3, -2, 2, 2);
  ellipse(3, -1, 2, 2);
